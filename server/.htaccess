RewriteEngine On

# --- Cache Control ---
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: no cache (ensures fresh hashed asset references on deploy)
  ExpiresByType text/html "access plus 0 seconds"

  # JS & CSS (content-hashed by Angular): cache 1 year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Fonts: cache 1 year
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # Images: cache 1 year
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Hashed assets: immutable cache
  <FilesMatch "\.[a-f0-9]{16}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fonts: long-term cache
  <FilesMatch "\.(ttf|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML: must revalidate
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- SPA Routing ---
# Redirect all requests to index.html unless the file or directory exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
